{
  "permissions": {
    "allow": ["Bash(make *)", "Bash(docker compose *)"],
    "deny": ["Read(./.env)", "Read(./**/*.pem)", "Read(./**/secrets/**)"]
  },
  "extraKnownMarketplaces": {
    "byt3un1on": {
      "source": { "source": "github", "repo": "byt3un1on/shared-claude-plugin" }
    }
  },
  "enabledPlugins": {
    "bu@byt3un1on": true,
    "bu-web@byt3un1on": true,
    "bu-typescript@byt3un1on": true
  }
}
