# Nada aqui e segredo. Estas variaveis sao lidas em TEMPO DE EXECUCAO, sem rebuildar a imagem.

# --- Producao (container nginx) ---
# Endereco interno da API; o nginx faz proxy de /api para ele. Sem barra final e sem caminho.
API_URL=http://pirometros-api:8000
# Resolver de DNS do nginx (127.0.0.11 e o DNS embutido do Docker/Swarm).
DNS_RESOLVER=127.0.0.11

# --- Desenvolvimento (Vite) ---
# Para onde o servidor de desenvolvimento encaminha /api.
API_PROXY_TARGET=http://host.docker.internal:8000
